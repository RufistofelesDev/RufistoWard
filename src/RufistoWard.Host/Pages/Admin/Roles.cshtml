@page "/admin/roles"
@model RufistoWard.Core.Pages.Admin.RolesModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Roles";
}

<rw-breadcrumb items="Dashboard|/admin;Roles"></rw-breadcrumb>

<div class="flex items-center justify-between mb-6">
    <h2 class="text-3xl font-heading font-bold text-ward-text">Roles</h2>
    <a href="/admin/roles/new" class="px-4 py-2 bg-ward-accent hover:bg-ward-accent-hover text-white font-medium rounded-lg transition">+ Add Role</a>
</div>

<form method="get" class="mb-6">
    <input type="text" name="search" value="@Model.Search" placeholder="Search roles..."
           class="w-full max-w-sm px-3 py-2 border-2 border-ward-border rounded-lg focus:border-ward-primary focus:outline-none" />
</form>

@if (Model.Items.Count == 0)
{
    <rw-empty-state message="No roles defined yet." action-url="/admin/roles/new" action-label="Add your first role"></rw-empty-state>
}
else
{
    <div class="bg-ward-surface border border-ward-border rounded-xl overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-ward-surface-alt border-b border-ward-border">
                <tr>
                    <th class="text-left px-4 py-3 font-medium text-ward-muted">Name</th>
                    <th class="text-left px-4 py-3 font-medium text-ward-muted">Description</th>
                    <th class="text-left px-4 py-3 font-medium text-ward-muted">Permissions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-ward-border">
                @foreach (var role in Model.Items)
                {
                    <tr class="hover:bg-ward-primary-light transition-colors cursor-pointer"
                        onclick="window.location='/admin/roles/@role.Id'">
                        <td class="px-4 py-3 font-medium">@role.Name</td>
                        <td class="px-4 py-3 text-ward-muted">@(role.Description ?? "—")</td>
                        <td class="px-4 py-3 text-ward-muted">@role.PermissionCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
