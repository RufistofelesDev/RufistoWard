@page "/admin/apps"
@model RufistoWard.Core.Pages.Admin.AppsModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Apps";
}

<rw-breadcrumb items="Dashboard|/admin;Apps"></rw-breadcrumb>

<div class="flex items-center justify-between mb-6">
    <h2 class="text-3xl font-heading font-bold text-ward-text">Apps</h2>
    <a href="/admin/apps/new" class="px-4 py-2 bg-ward-accent hover:bg-ward-accent-hover text-white font-medium rounded-lg transition">
        + Register App
    </a>
</div>

<!-- Search -->
<form method="get" class="mb-6">
    <input type="text" name="search" value="@Model.Search" placeholder="Search by name or client ID..."
           class="w-full max-w-sm px-3 py-2 border-2 border-ward-border rounded-lg focus:border-ward-primary focus:outline-none" />
</form>

@if (Model.Items.Count == 0)
{
    <rw-empty-state message="No apps registered yet." action-url="/admin/apps/new" action-label="Register your first app"></rw-empty-state>
}
else
{
    <div class="bg-ward-surface border border-ward-border rounded-xl overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-ward-surface-alt border-b border-ward-border">
                <tr>
                    <th class="text-left px-4 py-3 font-medium text-ward-muted">Name</th>
                    <th class="text-left px-4 py-3 font-medium text-ward-muted">Client ID</th>
                    <th class="text-left px-4 py-3 font-medium text-ward-muted">Grant Types</th>
                    <th class="text-left px-4 py-3 font-medium text-ward-muted">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-ward-border">
                @foreach (var app in Model.Items)
                {
                    <tr class="hover:bg-ward-primary-light transition-colors cursor-pointer"
                        onclick="window.location='/admin/apps/@app.ClientId'">
                        <td class="px-4 py-3 font-medium">@app.ClientName</td>
                        <td class="px-4 py-3 font-mono text-xs text-ward-muted">@app.ClientId</td>
                        <td class="px-4 py-3 text-ward-muted">@string.Join(", ", app.GrantTypes)</td>
                        <td class="px-4 py-3"><rw-status-badge status="@(app.Enabled ? "active" : "inactive")"></rw-status-badge></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalCount > Model.PageSize)
    {
        <div class="flex items-center justify-between mt-4 text-sm text-ward-muted">
            <span>Showing @((Model.Page - 1) * Model.PageSize + 1)–@Math.Min(Model.Page * Model.PageSize, Model.TotalCount) of @Model.TotalCount</span>
            <div class="flex gap-2">
                @if (Model.Page > 1)
                {
                    <a href="/admin/apps?page=@(Model.Page - 1)&search=@Model.Search" class="px-3 py-1 border border-ward-border rounded hover:bg-ward-surface transition">Previous</a>
                }
                @if (Model.Page * Model.PageSize < Model.TotalCount)
                {
                    <a href="/admin/apps?page=@(Model.Page + 1)&search=@Model.Search" class="px-3 py-1 border border-ward-border rounded hover:bg-ward-surface transition">Next</a>
                }
            </div>
        </div>
    }
}
