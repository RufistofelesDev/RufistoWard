@page "/admin/roles/{id:int}"
@model RufistoWard.Core.Pages.Admin.RoleDetailModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Role?.Name ?? "Role Not Found";
}

<rw-breadcrumb items="Dashboard|/admin;Roles|/admin/roles;@(Model.Role?.Name ?? "Not Found")"></rw-breadcrumb>

@if (Model.Role is null)
{
    <rw-empty-state message="Role not found." action-url="/admin/roles" action-label="Back to Roles"></rw-empty-state>
}
else
{
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <rw-toast type="success" message="@Model.SuccessMessage"></rw-toast>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <rw-toast type="error" message="@Model.ErrorMessage"></rw-toast>
    }

    <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-heading font-bold text-ward-text">@Model.Role.Name</h2>
        <form method="post" asp-page-handler="Delete" class="inline">
            <input type="hidden" name="id" value="@Model.Role.Id" />
            <button type="submit" onclick="return confirm('Delete this role? Users assigned to it will lose this role.')"
                    class="px-3 py-1.5 text-sm border border-ward-error text-ward-error rounded-lg hover:bg-red-50 transition">Delete</button>
        </form>
    </div>

    <form method="post" asp-page-handler="Update" class="bg-ward-surface border border-ward-border rounded-xl p-6 space-y-4">
        <input type="hidden" name="id" value="@Model.Role.Id" />
        <rw-form-field label="Name" name="name" value="@Model.Role.Name" required="true"></rw-form-field>
        <rw-form-field label="Description" name="description" value="@Model.Role.Description"></rw-form-field>
        <rw-form-field label="Permissions" name="permissions" value="@string.Join(", ", Model.Role.Permissions)"
                       help="Comma-separated list of permissions (e.g., clients:read, users:write)."></rw-form-field>
        <div class="pt-4">
            <button type="submit" class="px-4 py-2 bg-ward-primary text-white font-medium rounded-lg hover:bg-indigo-700 transition">Save Changes</button>
        </div>
    </form>
}
