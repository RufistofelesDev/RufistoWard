{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Server": {
    "BehindReverseProxy": false,
    "KnownProxyNetworks": []
  },
  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": "Host=localhost;Port=5432;Database=RufistoWard;Username=postgres;Password=postgres",
    "AutoMigrateOnStartup": false
  },
  "Token": {
    "Issuer": "https://localhost:5001",
    "AccessTokenLifetimeSeconds": 3600,
    "RefreshTokenLifetimeSeconds": 86400
  },
  "AdminAuth": {
    "Mode": "Local"
  },
  "KeyManagement": {
    "SigningKeyType": "RSA",
    "SigningAlgorithm": "RS256",
    "RotationIntervalDays": 90,
    "KeyStorageProvider": "FileSystem"
  },
  "SecurityHeaders": {
    "EnableHsts": true,
    "EnableCsp": true
  },
  "RateLimits": {
    "TokenEndpointPermitLimit": 100,
    "TokenEndpointWindowSeconds": 60
  }
}
