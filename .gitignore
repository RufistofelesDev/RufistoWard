Desktop.ini
_test-output/

# Vigil corpus manifest. Untracked on purpose: it names _bmad-output/planning-artifacts and
# _bmad-output/implementation-artifacts as sources, so publishing it would publish a map of exactly
# the material the history rewrite removed from this repository.
vigil.product.json
