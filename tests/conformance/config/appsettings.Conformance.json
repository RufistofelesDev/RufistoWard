{
  "//": "Conformance-harness OP config. Mounted into the rufistoward-op container as",
  "//_": "appsettings.Conformance.json with ASPNETCORE_ENVIRONMENT=Conformance. The issuer",
  "//__": "MUST equal the container DNS name the suite (server + browser) uses to reach the OP.",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "RufistoWard": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Server": {
    "BehindReverseProxy": false,
    "KnownProxyNetworks": []
  },
  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": "Host=postgres;Port=5432;Database=rufistoward_conformance;Username=postgres;Password=conformance",
    "AutoMigrateOnStartup": true
  },
  "Token": {
    "Issuer": "https://rufistoward-op:5001",
    "AccessTokenLifetimeSeconds": 3600,
    "RefreshTokenLifetimeSeconds": 86400
  },
  "AdminAuth": {
    "Mode": "Local"
  },
  "KeyManagement": {
    "SigningKeyType": "RSA",
    "SigningAlgorithm": "RS256",
    "RotationIntervalDays": 90,
    "KeyStorageProvider": "FileSystem"
  },
  "SecurityHeaders": {
    "EnableHsts": false,
    "EnableCsp": false
  },
  "RateLimits": {
    "TokenEndpointPermitLimit": 100000,
    "TokenEndpointWindowSeconds": 60
  }
}
